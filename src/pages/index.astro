---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

const logos = [
	{ name: "Google Sheets", slug: "googlesheets" },
	{ name: "Discord", slug: "discord" },
	{ name: "Notion", slug: "notion" },
	{ name: "Airtable", slug: "airtable" },
	{ name: "HubSpot", slug: "hubspot" },
	{ name: "Mailchimp", slug: "mailchimp" },
	{ name: "GitHub", slug: "github" },
	{ name: "Stripe", slug: "stripe" },
	{ name: "Shopify", slug: "shopify" },
	{ name: "Zoom", slug: "zoom" },
	{ name: "Telegram", slug: "telegram" },
	{ name: "WhatsApp", slug: "whatsapp" },
	{ name: "Trello", slug: "trello" },
	{ name: "Asana", slug: "asana" },
	{ name: "ClickUp", slug: "clickup" },
];
---

<Layout title="Noxitech | Buy Back Your Time with Automation">
	<!-- Hero Section -->
	<section
		class="relative min-h-svh flex flex-col overflow-hidden pt-28 sm:pt-32"
	>
		<!-- Artistic Background Elements: Starfield -->
		<div
			class="absolute inset-0 -z-10 bg-[radial-gradient(#ffffff_0.5px,transparent_0.5px)] bg-size-[24px_24px] opacity-[0.03]"
		>
		</div>
		<div
			class="absolute inset-0 -z-10 bg-[radial-gradient(#ffffff_1px,transparent_1px)] bg-size-[80px_80px] opacity-[0.05]"
		>
		</div>

		<!-- Floating Animated Stars -->
		<div
			class="absolute top-1/4 left-10 text-white opacity-20 animate-twinkle hidden lg:block"
		>
			<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
				><path
					d="M12 0l3.09 8.36L24 12l-8.91 3.64L12 24l-3.09-8.36L0 12l8.91-3.64z"
				></path></svg
			>
		</div>
		<div
			class="absolute bottom-1/3 right-20 text-white opacity-30 animate-twinkle-delayed hidden lg:block"
		>
			<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
				><path
					d="M12 0l3.09 8.36L24 12l-8.91 3.64L12 24l-3.09-8.36L0 12l8.91-3.64z"
				></path></svg
			>
		</div>
		<div
			class="absolute top-1/2 right-1/4 text-white opacity-10 animate-twinkle hidden lg:block"
		>
			<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"
				><path
					d="M12 0l3.09 8.36L24 12l-8.91 3.64L12 24l-3.09-8.36L0 12l8.91-3.64z"
				></path></svg
			>
		</div>
		<div
			class="absolute bottom-1/4 left-1/4 text-purple-400 opacity-20 animate-twinkle-delayed hidden lg:block"
		>
			<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
				><path
					d="M12 0l3.09 8.36L24 12l-8.91 3.64L12 24l-3.09-8.36L0 12l8.91-3.64z"
				></path></svg
			>
		</div>

		<div
			class="max-w-7xl mx-auto px-6 text-center relative z-10 flex-1 flex flex-col justify-center items-center w-full"
		>
			<div
				class="reveal-blur inline-flex items-center px-4 py-2 rounded-full bg-white/5 text-white text-[11px] sm:text-sm font-semibold mb-6 sm:mb-10 shadow-sm border border-white/10"
			>
				<span
					class="bg-primary text-white px-2 py-0.5 rounded-full text-[10px] uppercase font-bold tracking-wider shrink-0 mr-2"
					>Ready to Scale?</span
				>
				<span class="hidden sm:inline"
					>Helping businesses reclaim 20+ hours every week</span
				>
				<span class="sm:hidden">Reclaim 20+ hours weekly</span>
				<Icon
					name="lucide:arrow-right"
					class="w-3 h-3 sm:w-4 sm:h-4 ml-1 sm:ml-2 stroke-3 shrink-0"
				/>
			</div>

			<h1
				class="reveal-up stagger-1 text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white mb-6 sm:mb-8 max-w-5xl mx-auto leading-[1.05]"
			>
				Stop Doing <span class="emphasis">Manual Work</span>. <br /> Scale
				<span class="emphasis">Your Business.</span>
			</h1>

			<p
				class="reveal-up stagger-2 text-md sm:text-xl max-w-3xl mx-auto mb-8 sm:mb-12 leading-relaxed font-medium text-secondary"
			>
				We help small business owners save thousands of hours and
				dollars by building custom solutions that work.<span
					class="hidden sm:inline"
				>
					Reclaim your focus and invest your time where it matters
					most.</span
				>
			</p>

			<div class="reveal-up stagger-3 flex flex-wrap justify-center gap-6">
				<a
					href="/contact"
					class="btn-primary px-8! py-4! md:px-10! md:py-5! text-base! lg:text-lg! accent-glow"
				>
					Book a Free Audit
				</a>
			</div>
		</div>

		<!-- Scroll Indicator -->
		<div
			class="w-full flex flex-col items-center gap-2 text-secondary animate-fade-in opacity-0 pb-6 sm:pb-10 shrink-0 relative z-10 mt-4 sm:mt-2"
			style="animation-delay: 1s;"
		>
			<span class="text-[10px] uppercase font-bold tracking-[0.2em]"
				>Explore</span
			>
			<div
				class="w-6 h-10 border-2 border-white/20 rounded-full flex justify-center p-1.5"
			>
				<div
					class="w-1 h-2 bg-purple-500 rounded-full animate-scroll-dot"
				>
				</div>
			</div>
		</div>
	</section>

	<!-- Trust Signals / Social Proof -->
	<section class="py-24 overflow-hidden border-b border-white/5">
		<div class="max-w-7xl mx-auto px-6 text-center mb-12">
			<p
				class="text-[10px] uppercase font-bold tracking-[0.2em] text-secondary/50"
			>
				Systems We Master
			</p>
		</div>

		<div
			class="relative mask-[linear-gradient(to_right,transparent,black_15%,black_85%,transparent)]"
		>
			<div class="flex w-max animate-logo-scroll">
				<!-- First Set -->
				<div class="flex items-center gap-16 sm:gap-24 pr-16 sm:pr-24">
					{
						logos.map((logo) => (
							<img
								src={`https://cdn.simpleicons.org/${logo.slug}/white`}
								alt={logo.name}
								title={logo.name}
								class="h-10 sm:h-14 w-auto opacity-30 hover:opacity-100 transition-all duration-500 grayscale hover:grayscale-0"
								loading="lazy"
							/>
						))
					}
				</div>
				<!-- Duplicate Set for Seamless Loop -->
				<div class="flex items-center gap-16 sm:gap-24 pr-16 sm:pr-24">
					{
						logos.map((logo) => (
							<img
								src={`https://cdn.simpleicons.org/${logo.slug}/white`}
								alt={logo.name}
								title={logo.name}
								class="h-10 sm:h-14 w-auto opacity-30 hover:opacity-100 transition-all duration-500 grayscale hover:grayscale-0"
								loading="lazy"
							/>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- The Resistance: Deep Pain Points -->
	<section class="py-32 relative overflow-hidden">
		<div class="max-w-7xl mx-auto px-6">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
				<div>
					<h2
						class="text-base font-semibold text-primary uppercase tracking-[0.2em] mb-4"
					>
						The Reality
					</h2>
					<h3
						class="text-4xl sm:text-6xl font-black text-white mb-8 leading-[1.1]"
					>
						Manual work is the <br />
						<span class="emphasis">invisible tax</span>
						<br /> on your growth.
					</h3>
					<p
						class="text-xl text-secondary mb-12 font-medium leading-relaxed"
					>
						Most business owners aren't limited by their
						vision—they're limited by the hours spent on repetitive,
						soul-crushing admin that a machine could do in
						milliseconds.
					</p>

					<div
						class="flex items-center gap-4 p-6 rounded-2xl bg-rose-500/5 border border-rose-500/20 max-w-md"
					>
						<Icon
							name="lucide:alert-circle"
							class="w-6 h-6 text-rose-500 shrink-0"
						/>
						<p class="text-rose-200 text-sm font-semibold">
							The average founder loses 15-20 hours a week to
							tasks that don't produce revenue.
						</p>
					</div>
				</div>

				<div class="grid grid-cols-1 gap-6">
					{
						[
							{
								title: "The Admin Trap",
								desc: "Data entry, copy-pasting, and hunting for files. It's not 'working'—it's babysitting software.",
								icon: "lucide:lock",
							},
							{
								title: "The Human Bottleneck",
								desc: "If you need to be involved in every lead follow-up or invoice, you don't own a business—you own a high-stress job.",
								icon: "lucide:users",
							},
							{
								title: "The Growth Ceiling",
								desc: "You're turning away clients because your current manual systems are literally at their breaking point.",
								icon: "lucide:trending-down",
							},
						].map((pain) => (
							<div class="p-8 rounded-[2.5rem] bg-white/5 border border-white/10 hover:border-primary/40 transition-all group flex gap-6 items-start">
								<div class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center shrink-0 group-hover:bg-primary/20 transition-colors">
									<Icon
										name={pain.icon}
										class="w-6 h-6 text-primary"
									/>
								</div>
								<div>
									<h4 class="text-xl font-bold text-white mb-2">
										{pain.title}
									</h4>
									<p class="text-secondary leading-relaxed font-medium">
										{pain.desc}
									</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- The Value: ROI & Time Back -->
	<section
		class="py-32 relative overflow-hidden bg-white/1 border-y border-white/5"
	>
		<div
			class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/5 blur-[120px] rounded-full pointer-events-none"
		>
		</div>

		<div class="max-w-7xl mx-auto px-6 relative z-10">
			<div class="text-center mb-20">
				<h2
					class="text-base font-semibold text-primary uppercase tracking-[0.2em] mb-4"
				>
					The Result
				</h2>
				<h3 class="text-4xl sm:text-6xl font-black text-white mb-6">
					Buy Back <span class="emphasis">Your Freedom</span>
				</h3>
				<p class="text-xl text-secondary max-w-2xl mx-auto font-medium">
					We don't just build scripts; we build permanent operational
					assets that compound in value every single day.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{
					[
						{
							value: "20+ Hours",
							label: "Saved Weekly",
							sub: "The equivalent of 100 working days a year reclaimed for high-level strategy.",
							icon: "lucide:clock",
						},
						{
							value: "Zero Lag",
							label: "Response Time",
							sub: "Instant lead processing and contract generation while you sleep. No human delays.",
							icon: "lucide:zap",
						},
						{
							value: "100% Scale",
							label: "Capacity Growth",
							sub: "Your business is now built to handle 10x the volume without adding 10x the staff.",
							icon: "lucide:trending-up",
						},
					].map((stat) => (
						<div class="p-10 rounded-[3rem] bg-primary/5 border border-primary/20 text-center relative group overflow-hidden transition-all duration-500 hover:scale-[1.02] hover:bg-primary/10 hover:border-primary/40">
							<div class="absolute inset-0 bg-linear-to-b from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
							<div class="mb-6 inline-flex w-16 h-16 rounded-2xl bg-primary/10 items-center justify-center relative">
								<Icon
									name={stat.icon}
									class="w-8 h-8 text-primary"
								/>
							</div>
							<div class="text-4xl sm:text-5xl font-black text-white mb-2 leading-none relative">
								{stat.value}
							</div>
							<div class="text-primary font-bold uppercase tracking-widest text-xs mb-6 relative">
								{stat.label}
							</div>
							<p class="text-secondary font-medium leading-relaxed relative">
								{stat.sub}
							</p>
						</div>
					))
				}
			</div>

			<div class="mt-20 relative px-0 sm:px-10">
				<div
					class="absolute inset-0 bg-primary/10 blur-[100px] rounded-full opacity-30 -z-10"
				>
				</div>
				<div
					class="p-10 sm:p-16 rounded-[4rem] bg-slate-950 border-2 border-primary/20 shadow-2xl shadow-primary/10"
				>
					<div
						class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
					>
						<div>
							<h4
								class="text-sm font-black text-primary uppercase tracking-[0.3em] mb-6"
							>
								The Mathematical Truth
							</h4>
							<h5
								class="text-3xl sm:text-4xl font-black text-white mb-8 leading-tight"
							>
								Stop funding <span class="emphasis"
									>inefficiency.</span
								>
								<br /> Start building assets.
							</h5>
							<p
								class="text-lg text-secondary font-medium leading-relaxed"
							>
								Replacing a single $45k/year admin role with a
								custom Noxitech automation doesn't just save
								money—it eliminates human error and operates at
								<span
									class="text-white font-bold underline decoration-primary decoration-2 underline-offset-4"
									>1,000x the speed</span
								>, 24/7/365.
							</p>
						</div>
						<div
							class="bg-primary/5 rounded-[2.5rem] p-8 border border-primary/20 relative"
						>
							<div class="flex flex-col gap-6">
								<div
									class="flex items-center justify-between border-b border-primary/10 pb-4"
								>
									<span class="text-secondary font-bold"
										>Manual Cost</span
									>
									<span class="text-rose-400 font-black"
										>$45,000</span
									>
								</div>
								<div
									class="flex items-center justify-between border-b border-primary/10 pb-4"
								>
									<span class="text-secondary font-bold"
										>System Cost</span
									>
									<span class="text-emerald-400 font-black"
										>&lt; $5,000</span
									>
								</div>
								<div class="pt-2">
									<div
										class="flex flex-col sm:flex-row sm:items-end justify-between mb-2 gap-2 sm:gap-0"
									>
										<span
											class="text-white font-black text-xl sm:text-2xl uppercase tracking-tighter"
											>Net Savings</span
										>
										<span
											class="text-primary font-black text-4xl sm:text-5xl animate-pulse drop-shadow-[0_0_15px_rgba(153,51,255,0.4)]"
											>$40,000+</span
										>
									</div>
									<div
										class="w-full h-3 bg-white/5 rounded-full overflow-hidden"
									>
										<div
											class="w-[90%] h-full bg-primary shadow-[0_0_15px_rgba(153,51,255,0.6)]"
										>
										</div>
									</div>
									<p
										class="text-[10px] text-primary/60 font-black uppercase tracking-[0.2em] mt-4 text-center"
									>
										Guaranteed ROI in &lt; 90 Days
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Key Services (The Foundations) -->
	<section class="py-24">
		<div class="max-w-7xl mx-auto px-6">
			<div class="text-center mb-16">
				<h2
					class="text-base font-semibold text-primary uppercase tracking-[0.2em] mb-4"
				>
					Specialties
				</h2>
				<h3 class="text-4xl font-bold text-white">
					Core <span class="emphasis">Foundations</span>
				</h3>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{
					[
						{
							title: "High-Logic Workflows",
							desc: "Engineering bespoke digital engines that automate your unique business processes with 100% mathematical precision.",
							icon: "lucide:cpu",
						},
						{
							title: "System Integration",
							desc: "Connecting your disparate tech stack into a single, cohesive nervous system that moves data instantly and securely.",
							icon: "lucide:network",
						},
						{
							title: "Scalable Infrastructure",
							desc: "Building permanent operational assets designed to handle infinite complexity without increasing your human overhead.",
							icon: "lucide:ship",
						},
					].map((service) => (
						<div class="p-10 rounded-[3rem] bg-white/5 border border-white/10 hover:border-primary/40 transition-all duration-500 group relative overflow-hidden">
							<div class="absolute -top-24 -right-24 w-48 h-48 bg-primary/10 blur-[60px] rounded-full transition-opacity duration-500 opacity-0 group-hover:opacity-100" />
							<div class="w-16 h-16 rounded-3xl bg-primary/10 border border-primary/20 flex items-center justify-center mb-8 relative group-hover:scale-110 transition-transform duration-500">
								<Icon
									name={service.icon}
									class="w-8 h-8 text-primary"
								/>
							</div>
							<h3 class="text-2xl font-black text-white mb-4 relative">
								{service.title}
							</h3>
							<p class="text-secondary leading-relaxed font-medium relative italic!">
								{service.desc}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Final CTA -->
	<section class="py-32 text-center relative overflow-hidden">
		<div
			class="absolute inset-0 bg-primary/5 blur-[120px] rounded-full translate-y-1/2"
		>
		</div>
		<div class="max-w-7xl mx-auto px-6 relative z-10">
			<h3 class="text-4xl sm:text-6xl font-black text-white mb-12">
				Building assets, <span class="emphasis">not just tasks.</span>
			</h3>
			<p
				class="text-xl text-secondary max-w-2xl mx-auto mb-12 font-medium"
			>
				Ready to reclaim your time? Let's audit your workflow and find
				your first 20 hours.
			</p>
			<a
				href="/contact"
				class="btn-primary px-12! py-6! text-xl! shadow-2xl"
			>
				Book a Free Audit
			</a>
		</div>
	</section>
</Layout>

<style>
	@keyframes spin-slow {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}
	.animate-spin-slow {
		animation: spin-slow 12s linear infinite;
	}
</style>
