---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Noxitech | Innovating the Future of Tech">
	<!-- Hero Section -->
	<section class="relative overflow-hidden py-24 sm:py-32">
		<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_right,rgba(139,92,246,0.15),transparent_50%),radial-gradient(circle_at_bottom_left,rgba(59,130,246,0.15),transparent_50%)]"></div>
		<div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
			<div class="inline-flex items-center px-3 py-1 rounded-full border border-purple-500/20 bg-purple-500/10 text-purple-400 text-xs font-medium mb-8 animate-fade-in">
				<span class="relative flex h-2 w-2 mr-2">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"></span>
				</span>
				Now accepting Beta partners for 2026
			</div>
			<h1 class="text-5xl sm:text-7xl font-bold tracking-tight text-white mb-8">
				Building the <span class="text-gradient">Next Generation</span> of Software
			</h1>
			<p class="text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
				Noxitech provides enterprise-grade infrastructure and AI-driven solutions to help your business scale faster than ever before.
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<a href="/contact" class="px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white font-bold rounded-2xl transition-all shadow-xl shadow-purple-500/30 hover:scale-[1.02] active:scale-95">
					Start Building Now
				</a>
				<a href="/about" class="px-8 py-4 glass hover:bg-white/10 text-white font-bold rounded-2xl transition-all active:scale-95">
					See how it works
				</a>
			</div>
		</div>
	</section>

	<!-- Features Section -->
	<section class="py-24 bg-white/[0.02]">
		<div class="max-w-7xl mx-auto px-6 lg:px-8">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{[
					{ title: "Ultra Performance", desc: "Engineered for speed with the latest hardware and optimized software stacks.", icon: "⚡" },
					{ title: "AI-Native", desc: "Built-in intelligent agents that automate complex workflows and predict needs.", icon: "🤖" },
					{ title: "Military Grade", desc: "Zero-trust architecture ensuring your data remains encrypted and sovereign.", icon: "🛡️" }
				].map(feature => (
					<div class="glass p-8 rounded-3xl hover:border-purple-500/30 transition-all group">
						<div class="text-4xl mb-6 bg-slate-800 w-16 h-16 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform">{feature.icon}</div>
						<h3 class="text-xl font-bold text-white mb-4">{feature.title}</h3>
						<p class="text-slate-400 leading-relaxed">{feature.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Secondary CTA -->
	<section class="py-24">
		<div class="max-w-5xl mx-auto px-6 lg:px-8">
			<div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-purple-900/40 to-blue-900/40 p-12 text-center border border-white/10">
				<div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 pointer-events-none"></div>
				<h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">Ready to transform your workflow?</h2>
				<p class="text-slate-300 mb-10 max-w-xl mx-auto">Join 500+ teams who have already switched to Noxitech for their core infrastructure.</p>
				<a href="/pricing" class="inline-block px-10 py-4 bg-white text-slate-900 font-bold rounded-2xl hover:bg-slate-100 transition-all hover:scale-[1.02] active:scale-95">
					View Pricing Plans
				</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	@keyframes fade-in {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}
	.animate-fade-in {
		animation: fade-in 0.6s ease-out forwards;
	}
</style>
