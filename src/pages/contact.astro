---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Contact Us | Noxitech" description="Get in touch with the Noxitech team to save your business time.">
  <div class="pt-32 pb-24 sm:pt-40 sm:pb-32 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20">
        <div>
          <h2 class="text-base font-semibold leading-7 text-primary uppercase tracking-[0.2em]">Connect</h2>
          <h1 class="mt-2 text-5xl sm:text-7xl font-black tracking-tight text-white leading-tight">
            Stop doing <span class="emphasis">manual work</span> <br> today
          </h1>
          <p class="mt-8 text-xl leading-8 font-medium">
            Ready to scale your business with intelligent automation? Our team is ready to help you navigate the transition to a more efficient future.
          </p>

          <div class="mt-16 space-y-10">
            <div class="flex items-center gap-6 group">
              <div class="w-14 h-14 rounded-[1.25rem] bg-white/5 border border-white/10 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <Icon name="lucide:mail" class="w-6 h-6 text-primary" />
              </div>
              <div>
                <div class="text-white font-bold text-lg">Email Us</div>
                <div class="text-secondary font-medium">hello@noxitech.com</div>
              </div>
            </div>
            <div class="flex items-center gap-6 group">
              <div class="w-14 h-14 rounded-[1.25rem] bg-white/5 border border-white/10 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <Icon name="lucide:map-pin" class="w-6 h-6 text-primary" />
              </div>
              <div>
                <div class="text-white font-bold text-lg">Based In</div>
                <div class="text-secondary font-medium">Ontario, Canada</div>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white/5 p-8 sm:p-12 rounded-[3rem] border border-white/10 shadow-2xl backdrop-blur-md">
          <form class="space-y-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
              <div>
                <label for="first-name" class="block text-sm font-bold text-white mb-3">First name</label>
                <input type="text" id="first-name" class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 transition-all font-medium placeholder:text-white/30" placeholder="Jane" />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-bold text-white mb-3">Last name</label>
                <input type="text" id="last-name" class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 transition-all font-medium placeholder:text-white/30" placeholder="Doe" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-bold text-white mb-3">Email Address</label>
              <input type="email" id="email" class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 transition-all font-medium placeholder:text-white/30" placeholder="jane@company.com" />
            </div>
            <div>
              <label for="message" class="block text-sm font-bold text-white mb-3">Your Message</label>
              <textarea id="message" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 transition-all font-medium placeholder:text-white/30" placeholder="How can we help?"></textarea>
            </div>
            <button type="submit" class="btn-primary w-full !py-5 !text-lg">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>
