---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | Noxitech" description="Get in touch with the Noxitech team for support or inquiries.">
  <div class="py-24 sm:py-32 relative">
    <div class="absolute top-0 right-0 -z-10 w-1/2 h-1/2 bg-purple-600/5 blur-[120px]"></div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div>
          <h2 class="text-base font-semibold leading-7 text-purple-500 uppercase tracking-widest">Connect</h2>
          <h1 class="mt-2 text-4xl font-bold tracking-tight text-white sm:text-6xl">Let's build something great</h1>
          <p class="mt-6 text-lg leading-8 text-slate-400">
            Have questions about our platform or want to see a live demo? Our team of experts is ready to help you navigate the future of technology.
          </p>

          <div class="mt-12 space-y-8">
            <div class="flex items-center gap-6">
              <div class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center text-2xl">📧</div>
              <div>
                <div class="text-white font-semibold">Email Us</div>
                <div class="text-slate-400">hello@noxitech.com</div>
              </div>
            </div>
            <div class="flex items-center gap-6">
              <div class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center text-2xl">🏢</div>
              <div>
                <div class="text-white font-semibold">Visit Our HQ</div>
                <div class="text-slate-400">123 Tech Avenue, San Francisco, CA</div>
              </div>
            </div>
          </div>
        </div>

        <div class="glass p-8 sm:p-12 rounded-[2.5rem] border-white/10 shadow-2xl">
          <form class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-medium text-slate-300 mb-2">First name</label>
                <input type="text" id="first-name" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all" />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-medium text-slate-300 mb-2">Last name</label>
                <input type="text" id="last-name" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-300 mb-2">Work Email</label>
              <input type="email" id="email" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all" />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-slate-300 mb-2">Company</label>
              <input type="text" id="company" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all" />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-slate-300 mb-2">How can we help?</label>
              <textarea id="message" rows="4" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all"></textarea>
            </div>
            <button type="submit" class="w-full py-4 bg-purple-600 hover:bg-purple-700 text-white font-bold rounded-xl transition-all shadow-lg shadow-purple-500/25 active:scale-95">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>
