---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import FormInput from "../components/FormInput.astro";
import FormSelect from "../components/FormSelect.astro";
import FormTextarea from "../components/FormTextarea.astro";
import ContactSupport from "../components/ContactSupport.astro";

const contactOptions = [
  { value: "inquiry", label: "General Inquiry" },
  { value: "audit", label: "Get a Free Audit" },
  { value: "support", label: "Technical Support" },
];
---

<Layout
  title="Book a Free Audit | Noxitech"
  description="Get in touch with the Noxitech team to save your business time."
>
  <div class="pt-32 pb-24 sm:pt-40 sm:pb-32 relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20">
        <div>
          <h2
            class="text-base font-semibold leading-7 text-primary uppercase tracking-[0.2em]"
          >
            Contact
          </h2>
          <h1
            class="mt-2 text-5xl sm:text-7xl font-black tracking-tight text-white leading-tight"
          >
            Book your <br /><span class="emphasis">free audit</span>
            <br /> today
          </h1>
          <p class="mt-8 text-xl leading-8 font-medium">
            Ready to scale your business with intelligent automation? Our team
            is ready to help you navigate the transition to a more efficient
            future.
          </p>

          <div class="mt-16 space-y-10">
            <div class="flex items-center gap-6 group">
              <div
                class="w-14 h-14 rounded-[1.25rem] bg-white/5 border border-white/10 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
              >
                <Icon name="lucide:map-pin" class="w-6 h-6 text-primary" />
              </div>
              <div>
                <div class="text-white font-bold text-lg">Based In</div>
                <div class="text-secondary font-medium">Ontario, Canada</div>
              </div>
            </div>
          </div>
        </div>

        <div
          class="bg-white/5 p-8 sm:p-12 rounded-[3rem] border border-white/10 shadow-2xl backdrop-blur-md"
        >
          <form id="contact-form" class="space-y-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
              <FormInput
                label="First name"
                id="first-name"
                name="firstName"
                required
                placeholder="Jane"
                autocomplete="given-name"
              />
              <FormInput
                label="Last name"
                id="last-name"
                name="lastName"
                required
                placeholder="Doe"
                autocomplete="family-name"
              />
            </div>

            <FormInput
              label="Email Address"
              id="email"
              name="email"
              type="email"
              required
              placeholder="jane@company.com"
              autocomplete="email"
            />

            <FormSelect
              label="Why are you contacting us?"
              id="reason"
              name="reason"
              options={contactOptions}
              required
            />

            <div id="message-container">
              <FormTextarea
                label="Your Message"
                id="message"
                name="message"
                required
                placeholder="How can we help?"
              />
            </div>

            <input
              type="text"
              name="bot-field"
              class="hidden"
              tabindex="-1"
              autocomplete="off"
            />

            <button
              type="submit"
              id="submit-btn"
              class="btn-primary w-full py-5 text-lg cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Book My Free Audit</span>
              <Icon
                name="lucide:loader-2"
                class="w-5 h-5 animate-spin hidden"
                id="submit-loader"
              />
            </button>

            <div
              id="form-feedback"
              class="hidden p-4 rounded-2xl text-center font-medium transition-all duration-300 transform scale-95 opacity-0"
            >
            </div>
          </form>

          <p class="text-center text-secondary mt-8">
            Having trouble? <ContactSupport variant="link" label="contact us" />
          </p>
        </div>
      </div>
    </div>
  </div>

  <style>
    #form-feedback.show {
      display: block;
      transform: scale(1);
      opacity: 1;
    }
  </style>

  <script>
    const initContactForm = () => {
      const form = document.getElementById("contact-form") as HTMLFormElement;
      const reasonSelect = document.getElementById("reason") as HTMLSelectElement;
      const messageContainer = document.getElementById("message-container") as HTMLElement;
      const messageInput = document.getElementById("message") as HTMLTextAreaElement;
      const messageLabel = messageContainer?.querySelector("label") as HTMLLabelElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
      const submitLoader = document.getElementById("submit-loader") as HTMLElement;
      const btnText = submitBtn?.querySelector("span") as HTMLSpanElement;
      const feedback = document.getElementById("form-feedback") as HTMLElement;

      if (!form || !reasonSelect || !messageContainer || !messageInput || !feedback || !messageLabel) return;

      const clearErrors = () => {
        form?.querySelectorAll('[id$="-error"]').forEach(el => {
          el.textContent = '';
          el.classList.add('hidden');
        });
      };

      const showError = (id: string, msg: string) => {
        const el = document.getElementById(`${id}-error`);
        if (el) {
          el.textContent = msg;
          el.classList.remove('hidden');
        }
      };

      // Clear error on input
      form?.querySelectorAll('input, select, textarea').forEach(input => {
        const id = input.id;
        input.addEventListener('input', () => {
          const errorEl = document.getElementById(`${id}-error`);
          if (errorEl) errorEl.classList.add('hidden');
          if (feedback) feedback.classList.remove('show');
        });
        input.addEventListener('change', () => {
          const errorEl = document.getElementById(`${id}-error`);
          if (errorEl) errorEl.classList.add('hidden');
          if (feedback) feedback.classList.remove('show');
        });
      });

      // Handle dynamic message visibility based on reason
      reasonSelect.onchange = () => {
        const val = reasonSelect.value;
        if (val === "audit") {
          messageContainer.classList.add("hidden");
          messageInput.required = false;
        } else {
          messageContainer.classList.remove("hidden");
          messageInput.required = true;
          messageLabel.textContent =
            val === "support" ? "Your Issue" : "Your Message";
        }
      };

      form.onsubmit = async (e) => {
        e.preventDefault();
        clearErrors();

        // Anti-spam cooldown
        const last = localStorage.getItem("last_contact_submission");
        if (last && Date.now() - parseInt(last) < 600000) {
          feedback.textContent =
            "Please wait a few minutes before sending another message.";
          feedback.className = "bg-red-500/20 text-red-400 show p-4 rounded-2xl text-center font-medium mt-4";
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (submitLoader) submitLoader.classList.remove("hidden");
        if (btnText) btnText.textContent = "Sending...";
        if (feedback) feedback.classList.remove("show");

        try {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData);

          // Honeypot check
          if (data["bot-field"]) throw new Error("Bot detected");

          // Local Validation
          let hasErrors = false;
          if (!data.firstName) { showError('first-name', 'First name is required'); hasErrors = true; }
          if (!data.lastName) { showError('last-name', 'Last name is required'); hasErrors = true; }
          if (!data.email) { showError('email', 'Email is required'); hasErrors = true; }
          else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email.toString())) {
             showError('email', 'Please enter a valid email');
             hasErrors = true;
          }
          if (reasonSelect.value !== "audit" && !data.message) {
             showError('message', 'Please provide more details');
             hasErrors = true;
          }

          if (hasErrors) throw new Error("Please correct the errors above.");

          const response = await fetch("/api/submit-lead", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });

          const result = await response.json();

          if (response.ok && result.success) {
            feedback.textContent = "Message sent successfully!";
            feedback.classList.add("bg-green-500/20", "text-green-400", "show");
            feedback.classList.remove("hidden");
            form.reset();
            localStorage.setItem(
              "last_contact_submission",
              Date.now().toString(),
            );
          } else {
            throw new Error(result.error || "Submission failed");
          }
        } catch (err: any) {
          feedback.textContent = err.message || "Oops! Something went wrong.";
          feedback.className = "bg-red-500/20 text-red-400 show p-4 rounded-2xl text-center font-medium mt-4";
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (submitLoader) submitLoader.classList.add("hidden");
          if (btnText) btnText.textContent = "Book My Free Audit";
        }
      };

      // Handle URL query pre-selection
      const reasonQuery = new URLSearchParams(window.location.search).get(
        "reason",
      );
      if (reasonQuery) {
        reasonSelect.value = reasonQuery;
        reasonSelect.dispatchEvent(new Event("change"));
        // Update the custom select UI as well
        const customValueText = reasonSelect
          .closest(".custom-select-container")
          ?.querySelector(".custom-select-value");
        if (customValueText) {
          const option = Array.from(reasonSelect.options).find(
            (o) => o.value === reasonQuery,
          );
          if (option) {
            customValueText.textContent = option.text;
            customValueText.classList.remove("text-white/30");
            customValueText.classList.add("text-white");
          }
        }
      }
    };

    document.addEventListener("astro:page-load", initContactForm);
  </script>
</Layout>
