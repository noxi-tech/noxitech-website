---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us | Noxitech" description="Learn about the mission and team behind Noxitech.">
  <div class="py-24 sm:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-20">
        <h2 class="text-base font-semibold leading-7 text-purple-500 uppercase tracking-widest">Our Mission</h2>
        <h1 class="mt-2 text-4xl font-bold tracking-tight text-white sm:text-6xl">Redefining human-AI collaboration</h1>
        <p class="mt-6 text-lg leading-8 text-slate-400">
          Noxitech was founded in 2024 with a simple goal: to build infrastructure that makes high-performance AI accessible to every business, regardless of size or technical depth.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center mb-32">
        <div class="relative aspect-square rounded-[3rem] overflow-hidden group">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-600/20 to-blue-600/20 z-10"></div>
          <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&q=80&w=1000" alt="Team working" class="object-cover w-full h-full transition-transform duration-700 group-hover:scale-110" />
        </div>
        <div>
          <h2 class="text-3xl font-bold text-white mb-6">Built for the future</h2>
          <p class="text-slate-400 mb-6 leading-relaxed">
            We believe that the next decade of software will be defined by autonomous systems. Our platform is designed from the ground up to support these systems with zero-latency data processing and ethical AI guardrails.
          </p>
          <div class="grid grid-cols-2 gap-8 pt-8 border-t border-white/10">
            <div>
              <div class="text-4xl font-bold text-white mb-1">500+</div>
              <div class="text-slate-500 text-sm">Active Enterprise Clients</div>
            </div>
            <div>
              <div class="text-4xl font-bold text-white mb-1">99.9%</div>
              <div class="text-slate-500 text-sm">Infrastructure Uptime</div>
            </div>
          </div>
        </div>
      </div>

      <div class="glass rounded-[3rem] p-12 text-center">
        <h2 class="text-3xl font-bold text-white mb-12">Our Core Values</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 text-left">
          {[
            { title: "Transparency First", desc: "No black boxes. We provide full visibility into how our models think and operate." },
            { title: "Security by Design", desc: "Security isn't a feature; it's the foundation of every line of code we write." },
            { title: "Customer Success", desc: "We don't just sell software; we partner with you to ensure your goals are met." }
          ].map((value, index) => (
            <div>
              <div class="text-purple-500 font-bold mb-4">0{index + 1}</div>
              <h3 class="text-xl font-bold text-white mb-3">{value.title}</h3>
              <p class="text-slate-400 text-sm leading-relaxed">{value.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
