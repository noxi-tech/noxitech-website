---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout
  title="About Us | Noxitech"
  description="Learn about the mission and team behind Noxitech."
>
  <div class="pt-32 pb-24 sm:pt-40 sm:pb-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Mission & Hero Context -->
      <div class="max-w-3xl mx-auto text-center mb-24">
        <h2
          class="text-base font-semibold leading-7 text-primary uppercase tracking-[0.2em]"
        >
          Our Purpose
        </h2>
        <h1
          class="mt-2 text-5xl sm:text-7xl font-black tracking-tight text-white leading-tight"
        >
          Engineering <span class="emphasis">Operational Liberty</span>
        </h1>
        <p class="mt-8 text-xl leading-8 font-medium text-secondary">
          At Noxitech, we don't believe in boxed software. We build bespoke
          digital engines designed to solve your specific inefficiencies and
          provide a mathematically undeniable return on investment.
        </p>
      </div>

      <!-- Custom Solutions Visual Grid -->
      <div class="mb-40">
        <h2 class="text-3xl font-black text-white mb-16 text-center">
          What <span class="emphasis">We Deliver</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {
            [
              {
                title: "Custom API Engines",
                desc: "Connecting your software into a single, cohesive nervous system.",
                icon: "lucide:cpu",
              },
              {
                title: "Autonomous Flow",
                desc: "Workflows that run 24/7 without needing a single click.",
                icon: "lucide:zap",
              },
              {
                title: "Data Intelligence",
                desc: "Visualizing your complexity into simple, actionable insights.",
                icon: "lucide:bar-chart-3",
              },
              {
                title: "AI Deployment",
                desc: "Training models on your specific business data for unique ROI.",
                icon: "lucide:bot",
              },
            ].map((item) => (
              <div class="p-8 rounded-4xl bg-white/5 border border-white/10 hover:border-primary/30 transition-all group">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                  <Icon name={item.icon} class="w-6 h-6 text-primary" />
                </div>
                <h3 class="text-xl font-bold text-white mb-3">{item.title}</h3>
                <p class="text-sm text-secondary leading-relaxed font-medium">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Visual ROI Section (The Graphs) -->
      <div class="mb-40 relative">
        <div
          class="absolute inset-x-0 -top-24 -bottom-24 bg-primary/5 blur-[120px] -z-10 rounded-full opacity-50"
        >
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-4xl font-black text-white mb-8">
              The Physics of <br /><span class="emphasis">Efficiency</span>
            </h2>
            <p class="text-lg text-secondary mb-10 leading-relaxed font-medium">
              We focus on the metrics that matter. By mapping your current
              manual hours against an automated state, we visualize exactly how
              your business will regain its most valuable asset: <span
                class="emphasis text-3xl sm:text-4xl align-middle mx-1"
                >Time</span
              >.
            </p>
            <div class="space-y-8">
              <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
                <div class="flex justify-between items-end mb-4">
                  <span
                    class="text-sm font-bold uppercase tracking-widest text-white/50"
                    >Manual Efficiency</span
                  >
                  <span class="text-2xl font-black text-rose-500">12%</span>
                </div>
                <div class="w-full h-2 bg-white/5 rounded-full overflow-hidden">
                  <div
                    class="w-[12%] h-full bg-rose-500 rounded-full shadow-[0_0_10px_rgba(244,63,94,0.5)]"
                  >
                  </div>
                </div>
              </div>
              <div class="p-6 rounded-2xl bg-white/5 border border-white/10">
                <div class="flex justify-between items-end mb-4">
                  <span
                    class="text-sm font-bold uppercase tracking-widest text-white/50"
                    >Automated Capacity</span
                  >
                  <span class="text-2xl font-black text-emerald-500">98%</span>
                </div>
                <div class="w-full h-2 bg-white/5 rounded-full overflow-hidden">
                  <div
                    class="w-[98%] h-full bg-emerald-500 rounded-full shadow-[0_0_15px_rgba(16,185,129,0.5)]"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div
            class="bg-slate-950 p-10 rounded-[3rem] border border-white/10 shadow-3xl shadow-primary/10 relative overflow-hidden group"
          >
            <div
              class="flex items-center gap-2 mb-8 border-b border-white/10 pb-6"
            >
              <div class="flex gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-rose-500/30"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-amber-500/30"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/30"></div>
              </div>
              <span
                class="text-[10px] font-bold text-white/20 ml-2 uppercase tracking-[0.3em]"
                >Projection Engine v1.0</span
              >
            </div>

            <!-- Simple Mock Graph Representation -->
            <div class="flex items-end gap-3 h-48 mb-8 px-4">
              {
                [30, 45, 25, 60, 40, 75, 55, 95].map((h, i) => (
                  <div
                    class="flex-1 rounded-t-lg bg-primary/20 border-t border-x border-primary/30 relative"
                    style={`height: ${h}%`}
                  >
                    {i === 7 && (
                      <div class="absolute -top-3 -right-3 w-6 h-6 rounded-full bg-primary flex items-center justify-center shadow-lg animate-pulse">
                        <Icon
                          name="lucide:arrow-up-right"
                          class="w-4 h-4 text-white"
                        />
                      </div>
                    )}
                  </div>
                ))
              }
            </div>
            <div
              class="flex justify-between text-[10px] font-black uppercase tracking-[0.2em] text-white/30 px-2"
            >
              <span>Setup</span>
              <span>Integrate</span>
              <span>Scale</span>
            </div>
            <div
              class="mt-10 p-6 rounded-2xl bg-primary/10 border border-primary/20 text-center"
            >
              <span
                class="text-xs font-bold text-primary uppercase tracking-widest block mb-1"
                >Estimated Annual Savings</span
              >
              <span class="text-3xl font-black text-white">$45,000+</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Core Philosophy with Large Icons -->
      <div class="mb-40">
        <h2 class="text-4xl font-black text-white mb-20 text-center">
          Our <span class="emphasis">Operational DNA</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-16">
          {
            [
              {
                title: "Mathematically Sound",
                desc: "We prioritize projects where the ROI is clear and undeniable. If the automation doesn't save you more than it costs, we redefine the target.",
                icon: "lucide:compass",
              },
              {
                title: "Security-First Architecture",
                desc: "Your data is your most valuable asset. We build with enterprise-grade encryption and secure API handshakes, ensuring your internal logic remains private and protected.",
                icon: "lucide:lock",
              },
              {
                title: "Precision Customization",
                desc: "Every logic branch is mapped to your specific business rules. We are bridge-builders, connecting your current state to your ideal future.",
                icon: "lucide:layers",
              },
            ].map((value, index) => (
              <div class="flex flex-col items-center text-center group">
                <div class="w-20 h-20 rounded-3xl bg-white/5 border border-white/10 flex items-center justify-center mb-8 relative">
                  <div class="absolute -top-8 -right-6 pointer-events-none transition-transform duration-700 group-hover:-translate-y-2 select-none">
                    <span class="emphasis text-6xl font-black text-primary/30">
                      0{index + 1}
                    </span>
                  </div>
                  <Icon
                    name={value.icon}
                    class="w-10 h-10 text-primary opacity-80"
                  />
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">
                  {value.title}
                </h3>
                <p class="text-secondary leading-relaxed font-medium">
                  {value.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Trust Signal / Final Note -->
      <div
        class="max-w-4xl mx-auto rounded-[4rem] p-12 sm:p-24 text-center bg-white/5 border border-white/5 relative overflow-hidden"
      >
        <div
          class="absolute -top-24 -left-24 w-64 h-64 bg-primary/10 blur-[100px] rounded-full"
        >
        </div>
        <div class="relative z-10">
          <h2 class="text-4xl font-black text-white mb-8">
            Ready for <span class="emphasis">Real ROI</span>?
          </h2>
          <p class="text-xl text-secondary mb-12 max-w-2xl mx-auto font-medium">
            We specialize in turning manual bottlenecks into permanent
            operational assets. Let's build a solution together that gives you
            back your time and scale.
          </p>
          <a
            href="/contact?reason=audit"
            class="btn-primary px-12! py-6! text-xl! shadow-2xl"
          >
            Book a Free Strategy Audit
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .shadow-3xl {
    box-shadow: 0 35px 60px -15px rgba(0, 0, 0, 0.3);
  }
</style>
