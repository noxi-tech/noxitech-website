---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us | Noxitech" description="Learn about the mission and team behind Noxitech.">
  <div class="pt-32 pb-24 sm:pt-40 sm:pb-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-20">
        <h2 class="text-base font-semibold leading-7 text-primary uppercase tracking-[0.2em]">Our Mission</h2>
        <h1 class="mt-2 text-5xl sm:text-7xl font-black tracking-tight text-white leading-tight">
          Reclaiming your time <br> through <span class="emphasis">Digital Innovation</span>
        </h1>
        <p class="mt-8 text-xl leading-8 font-medium">
          Noxitech was built to help small and medium business owners escape the trap of manual work. We specialize in building custom automation that works, ensuring you save time and money while your business runs itself.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center mb-32">
        <div class="relative aspect-[4/3] rounded-[3rem] overflow-hidden group shadow-2xl border border-white/5">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-600/20 to-blue-600/20 z-10"></div>
          <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1000" alt="Modern office workspace" class="object-cover w-full h-full transition-transform duration-700 group-hover:scale-110 opacity-70" />
        </div>
        <div>
          <h2 class="text-4xl font-bold text-white mb-8 leading-tight">Built for <br> <span class="emphasis">Scale & Growth</span></h2>
          <p class="mb-8 leading-relaxed font-medium text-lg">
            We understand the challenges of growing a successful business. Our mission is to lower the barrier to advanced technology. We build secure, efficient systems that eliminate steep monthly overhead and give you enterprise-level power at an SMB price point.
          </p>
          <div class="grid grid-cols-2 gap-12 pt-10 border-t border-white/10">
            <div>
              <div class="text-5xl font-black text-white mb-2 tracking-tighter">100%</div>
              <div class="text-secondary font-semibold text-sm uppercase tracking-wider">Data Privacy</div>
            </div>
            <div>
              <div class="text-5xl font-black text-white mb-2 tracking-tighter">24/7</div>
              <div class="text-secondary font-semibold text-sm uppercase tracking-wider">Automated Systems</div>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white/5 rounded-[3rem] p-12 sm:p-24 text-center border border-white/5">
        <h2 class="text-4xl font-black text-white mb-16">Our <span class="emphasis">Core Values</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 text-left">
          {[
            { title: "Automation First", desc: "If a task is repetitive, it's our mission to automate it, freeing your team for higher-value work." },
            { title: "Intelligent Design", desc: "We don't build tech for tech's sake. Every feature is designed with a specific ROI in mind." },
            { title: "Future Proof", desc: "Our solutions are built to grow with you, using scalable architectures and adaptable AI models." }
          ].map((value, index) => (
            <div class="flex flex-col">
              <div class="text-primary font-black text-2xl mb-6">0{index + 1}</div>
              <h3 class="text-2xl font-bold text-white mb-4">{value.title}</h3>
              <p class="text-base leading-relaxed font-medium">{value.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
