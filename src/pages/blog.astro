---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout
    title="Blog | Noxitech"
    description="Insights, guides, and thought leadership on operational efficiency and automation."
>
    <div class="pt-32 pb-24 sm:pt-40 sm:pb-32">
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <!-- Header -->
            <div class="max-w-3xl mx-auto text-center mb-24 relative">
                <div
                    class="absolute inset-x-0 -top-24 bg-primary/20 blur-[120px] -z-10 h-64 rounded-full opacity-50 pointer-events-none"
                >
                </div>
                <h2
                    class="text-base font-semibold leading-7 text-primary uppercase tracking-[0.2em]"
                >
                    Resources & Insights
                </h2>
                <h1
                    class="mt-2 text-5xl sm:text-7xl font-black tracking-tight text-white leading-tight"
                >
                    The <span class="emphasis">Automation Log</span>
                </h1>
                <p class="mt-8 text-xl leading-8 font-medium text-secondary">
                    Deep dives into solving operational bottlenecks, reclaiming
                    your time, and building frictionless digital
                    infrastructures.
                </p>
            </div>

            <!-- Featured Post -->
            <div
                class="relative w-full rounded-[3rem] bg-white/5 border border-white/10 overflow-hidden mb-16 hover:border-primary/40 transition-colors group"
            >
                <div
                    class="absolute inset-0 bg-primary/5 group-hover:bg-primary/10 transition-colors -z-10"
                >
                </div>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-8 p-8 md:p-16 items-center"
                >
                    <div class="order-2 md:order-1">
                        <span
                            class="inline-flex items-center px-3 justify-center py-1 rounded-full bg-primary/20 text-primary text-xs font-bold uppercase tracking-wider mb-6"
                        >
                            Featured Insight
                        </span>
                        <h2
                            class="text-3xl sm:text-5xl font-black text-white mb-6 leading-tight"
                        >
                            5 Signs Your Operations Are Bleeding Money (And
                            Time)
                        </h2>
                        <p
                            class="text-secondary text-lg font-medium leading-relaxed mb-8"
                        >
                            Manual data entry doesn't just waste your employees'
                            time—it's actively damaging your revenue ceiling.
                            Here's how to spot the invisible taxes on your
                            business before your competitors do.
                        </p>
                        <a
                            href="#"
                            class="inline-flex items-center text-primary font-bold hover:text-white transition-colors group/link"
                        >
                            Read Article
                            <Icon
                                name="lucide:arrow-right"
                                class="w-4 h-4 ml-2 group-hover/link:translate-x-1 transition-transform"
                            />
                        </a>
                    </div>
                    <div
                        class="order-1 md:order-2 h-64 md:h-full min-h-[300px] w-full bg-slate-900 rounded-4xl border border-white/5 flex items-center justify-center overflow-hidden"
                    >
                        <Icon
                            name="lucide:database-zap"
                            class="w-32 h-32 text-primary/40 group-hover:scale-110 transition-transform duration-700"
                        />
                    </div>
                </div>
            </div>

            <!-- Blog Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-32">
                {
                    [
                        {
                            title: "The Mathematical Truth about API Engines",
                            tag: "Engineering",
                            readTime: "4 min read",
                            date: "October 12, 2026",
                            desc: "Connecting your disparate tech stack isn't just a technical upgrade; it's a structural necessity for modern scale.",
                            icon: "lucide:network",
                        },
                        {
                            title: "Stop Renting Software. Start Building Assets.",
                            tag: "Strategy",
                            readTime: "6 min read",
                            date: "September 28, 2026",
                            desc: "Why monthly SaaS subscriptions will never perfectly map to your unique business logic—and what to do about it.",
                            icon: "lucide:layers",
                        },
                        {
                            title: "Automating High-Logic Lead Enrichment",
                            tag: "Growth",
                            readTime: "5 min read",
                            date: "September 15, 2026",
                            desc: "How to instantly analyze and route premium B2B leads using deterministic workflows and AI integration.",
                            icon: "lucide:trending-up",
                        },
                        {
                            title: "How Missing Webhooks Kill Conversion Rates",
                            tag: "Technical",
                            readTime: "3 min read",
                            date: "August 30, 2026",
                            desc: "If your sales team has to query a database to find new leads, your architecture is broken. Meet the automated webhook.",
                            icon: "lucide:repeat",
                        },
                        {
                            title: "The Human Element in Automation",
                            tag: "Philosophy",
                            readTime: "7 min read",
                            date: "August 18, 2026",
                            desc: "Automation shouldn't replace your best people; it should liberate them from drudgery so they can actually think.",
                            icon: "lucide:lightbulb",
                        },
                        {
                            title: "Calculating True ROI on Scripted Solutions",
                            tag: "Finance",
                            readTime: "5 min read",
                            date: "August 02, 2026",
                            desc: "Learn to calculate the exact breakpoint where a bespoke automation script becomes infinitely cheaper than human labor.",
                            icon: "lucide:calculator",
                        },
                    ].map((post) => (
                        <div class="p-8 rounded-4xl bg-white/5 border border-white/10 hover:border-primary/30 transition-all flex flex-col group cursor-pointer relative overflow-hidden h-full">
                            <div class="absolute -top-12 -right-12 w-24 h-24 bg-primary/10 blur-2xl rounded-full transition-opacity duration-500 opacity-0 group-hover:opacity-100 pointer-events-none" />

                            <div class="w-12 h-12 rounded-xl bg-slate-900 border border-white/5 flex items-center justify-center shrink-0 mb-6 group-hover:bg-primary/10 transition-colors">
                                <Icon
                                    name={post.icon}
                                    class="w-6 h-6 text-primary"
                                />
                            </div>

                            <div class="flex items-center gap-3 mb-4">
                                <span class="text-[10px] uppercase font-bold text-primary tracking-widest">
                                    {post.tag}
                                </span>
                                <span class="w-1 h-1 rounded-full bg-white/20" />
                                <span class="text-[10px] uppercase font-bold text-white/50 tracking-widest">
                                    {post.readTime}
                                </span>
                            </div>

                            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-primary transition-colors">
                                {post.title}
                            </h3>
                            <p class="text-sm text-secondary leading-relaxed font-medium mb-8 grow">
                                {post.desc}
                            </p>

                            <div class="flex items-center justify-between border-t border-white/10 pt-4 mt-auto">
                                <span class="text-xs font-semibold text-white/40">
                                    {post.date}
                                </span>
                                <Icon
                                    name="lucide:arrow-right"
                                    class="w-5 h-5 text-white/40 group-hover:text-white group-hover:translate-x-1 transition-all"
                                />
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</Layout>
