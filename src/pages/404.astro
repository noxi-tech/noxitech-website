---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout
  title="404: Page Not Found | Noxitech"
  description="The page you are looking for does not exist. Return to Noxitech to reclaim your time with automation."
  robots="noindex, follow"
>
  <div class="pt-24 pb-24 sm:pt-24 sm:pb-32">
    <div
      class="min-h-[80svh] flex flex-col items-center justify-center text-center px-6 relative overflow-hidden"
    >
      <!-- Background Glows -->
      <div class="absolute inset-0 -z-10 pointer-events-none">
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-4xl h-96 bg-primary/10 blur-[120px] rounded-full opacity-50"
        >
        </div>
      </div>

      <div class="relative z-10 max-w-2xl mx-auto">
        <div
          class="inline-flex items-center justify-center w-24 h-24 rounded-3xl bg-secondary/5 border border-white/10 mb-8 animate-pulse"
        >
          <Icon name="lucide:ghost" class="w-12 h-12 text-primary" />
        </div>

        <h1 class="text-6xl sm:text-8xl font-black text-white mb-6">
          4<span class="emphasis">0</span>4
        </h1>

        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-6">
          This <span class="emphasis">Page</span> Doesn't Exist
        </h2>

        <p
          class="text-lg text-secondary mb-12 font-medium leading-relaxed max-w-lg mx-auto"
        >
          The page you are looking for seems to be offline or has been moved to
          a new page. Let's get you back on track.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="btn-primary px-10! py-4! text-lg!">
            Return Home
          </a>
          <a
            href="/contact"
            class="btn-secondary px-10! py-4! text-lg! bg-white/5 border border-white/10 hover:bg-white/10"
          >
            Contact Support
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
