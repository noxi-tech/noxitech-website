---
import Layout from "../layouts/Layout.astro";
import StateScreen from "../components/StateScreen.astro";
import FormInput from "../components/FormInput.astro";
import FormSelect from "../components/FormSelect.astro";
import FormTextarea from "../components/FormTextarea.astro";
import { Icon } from "astro-icon/components";

// Get token from URL
const token = Astro.url.searchParams.get("token");

const revenueOptions = [
  { value: "<$100k", label: "Less than $100,000" },
  { value: "$100k-$500k", label: "$100,000 - $500,000" },
  { value: "$500k-$2M", label: "$500,000 - $2,000,000" },
  { value: "$2M+", label: "$2,000,000+" },
];
---

<Layout
  title="Get Vetted | Noxitech"
  description="Finalize your qualification."
  robots="noindex, nofollow"
  hideHeader={true}
  hideFooter={true}
>
  <div
    class="min-h-screen flex items-center justify-center pt-16 pb-24 relative overflow-hidden"
  >
    <!-- Background Decor (same as audit page) -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 pointer-events-none"
    >
      <div
        class="absolute top-[10%] left-[10%] w-[30%] h-[30%] bg-purple-600/10 rounded-full blur-[120px] animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-[20%] right-[5%] w-[40%] h-[40%] bg-primary/5 rounded-full blur-[100px]"
      >
      </div>
    </div>

    <div class="max-w-2xl w-full mx-auto px-6 relative z-10">
      <!-- State: Loading (Mimicking audit page) -->
      <StateScreen
        id="loading-state"
        type="loading"
        title="Preparing Your Profile"
        description="Just a moment while we get your tailored application ready."
        hidden={false}
      >
        <div
          class="flex items-center gap-3 text-[10px] uppercase font-bold tracking-[0.3em] text-primary/60"
        >
          <span
            class="inline-block w-2 h-2 rounded-full bg-primary animate-ping"
          ></span>
          Linking Your Account
        </div>
      </StateScreen>

      <!-- State: Error / Invalid -->
      <StateScreen
        id="error-state"
        type="error"
        title="Link Expired"
        description="It look like this link is no longer active. We can help you get a new one."
      >
        <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
          <a
            href="/contact"
            class="btn-primary px-8 py-4 flex items-center justify-center"
            >Contact Support</a
          >
          <a
            href="/"
            class="btn-secondary px-8 py-4 bg-white/5 border border-white/10 hover:bg-white/10 flex items-center justify-center"
            >Back to Home</a
          >
        </div>
      </StateScreen>

      <!-- State: Already Vetted -->
      <StateScreen
        id="success-state"
        type="success"
        title="All Set!"
        description="You've already completed the vetting process. Our team is already on top of it!"
      >
        <div class="flex justify-center w-full">
          <a href="/" class="btn-primary px-12 py-4">Return to Home</a>
        </div>
      </StateScreen>

      <!-- State: Submission Success -->
      <StateScreen
        id="vetting-success-state"
        type="success"
        title="Application Sent!"
        description="We've received your details and our team will be in touch within 24 hours to schedule your audit."
      >
        <div class="flex justify-center w-full">
          <a href="/" class="btn-primary px-12 py-4">Close & Return Home</a>
        </div>
      </StateScreen>

      <!-- Vetting Form Container -->
      <div
        id="vetting-form-container"
        class="hidden transition-all duration-700 opacity-0 translate-y-4"
      >
        <div class="text-center mb-12">
          <h1
            class="text-4xl sm:text-5xl font-black tracking-tight text-white mb-2"
          >
            Welcome <span class="emphasis" id="contact-firstname">Friend</span>
          </h1>
          <p class="text-secondary font-medium italic">
            Please provide a few more details to finalize your application.
          </p>
        </div>

        <div
          class="bg-white/5 p-8 sm:p-12 rounded-[3rem] border border-white/10 shadow-2xl backdrop-blur-md"
        >
          <form id="vetting-form" class="space-y-6">
            <input type="hidden" name="token" value={token} />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <FormInput
                label="Company Name"
                id="company-name"
                name="companyName"
                placeholder="e.g. Acme Corp"
                required
              />
              <FormInput
                label="Company Domain"
                id="company-domain"
                name="companyDomain"
                placeholder="e.g. acme.com"
                required
                pattern="^[a-zA-Z0-9][a-zA-Z0-9-]{1,61}[a-zA-Z0-9]\\.[a-zA-Z]{2,}$"
                title="Please enter a valid domain (e.g., domain.com)"
              />
            </div>

            <FormInput
              label="Phone Number"
              id="phone"
              name="phone"
              type="tel"
              placeholder="e.g. (555) 000-0000"
              required
              pattern="^\\+?[\\d\\s\\-()]{10,}$"
              title="Please enter a valid phone number"
            />

            <FormSelect
              label="What is your approximate annual revenue?"
              id="annual-revenue"
              name="annualRevenue"
              placeholder="Select range"
              options={revenueOptions}
              required
            />

            <FormTextarea
              label="What is the problem that you need to solve?"
              id="problem"
              name="problem"
              placeholder="Describe the main challenge..."
              required
            />

            <div>
              <label
                for="hours-lost"
                class="block text-sm font-bold text-white mb-3"
              >
                How many hours a week is this manual task costing you?
              </label>
              <div class="relative group">
                <input
                  type="number"
                  id="hours-lost"
                  name="hoursLost"
                  min="0"
                  max="168"
                  required
                  class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 transition-all font-medium placeholder:text-white/30"
                  placeholder="e.g. 15"
                />
                <div
                  class="absolute right-2 top-1/2 -translate-y-1/2 flex flex-col gap-1 pr-2"
                >
                  <button
                    type="button"
                    id="increment-hours"
                    class="p-1 hover:text-primary transition-colors text-white/30 cursor-pointer"
                  >
                    <Icon name="lucide:chevron-up" class="w-4 h-4" />
                  </button>
                  <button
                    type="button"
                    id="decrement-hours"
                    class="p-1 hover:text-primary transition-colors text-white/30 cursor-pointer"
                  >
                    <Icon name="lucide:chevron-down" class="w-4 h-4" />
                  </button>
                </div>
              </div>
            </div>

            <div>
              <label class="block text-sm font-bold text-white mb-3"
                >Are you the final decision maker?</label
              >
              <div class="flex gap-4">
                <label class="flex-1 cursor-pointer group">
                  <input
                    type="radio"
                    name="isDecisionMaker"
                    value="yes"
                    class="peer hidden"
                    required
                  />
                  <div
                    class="w-full text-center py-4 rounded-2xl bg-white/5 border border-white/10 text-white/50 peer-checked:bg-primary/20 peer-checked:border-primary peer-checked:text-white transition-all font-bold"
                  >
                    Yes
                  </div>
                </label>
                <label class="flex-1 cursor-pointer group">
                  <input
                    type="radio"
                    name="isDecisionMaker"
                    value="no"
                    class="peer hidden"
                  />
                  <div
                    class="w-full text-center py-4 rounded-2xl bg-white/5 border border-white/10 text-white/50 peer-checked:bg-primary/20 peer-checked:border-primary peer-checked:text-white transition-all font-bold"
                  >
                    No
                  </div>
                </label>
              </div>
            </div>

            <div
              id="decision-maker-name-container"
              class="hidden opacity-0 translate-y-2 transition-all duration-300"
            >
              <FormInput
                label="What is the decision maker's name & role?"
                id="decision-maker-name"
                name="decisionMakerName"
                placeholder="e.g. John Doe, CEO"
              />
            </div>

            <input
              type="text"
              name="bot-field"
              class="hidden"
              tabindex="-1"
              autocomplete="off"
            />

            <button
              type="submit"
              id="submit-btn"
              class="btn-primary w-full py-5 text-lg cursor-pointer flex items-center justify-center gap-2 mt-4"
            >
              <span>Complete Vetting</span>
              <Icon
                name="lucide:loader-2"
                class="w-5 h-5 animate-spin hidden"
                id="submit-loader"
              />
            </button>

            <div
              id="form-feedback"
              class="hidden p-4 rounded-2xl text-center font-medium transition-all duration-300 transform scale-95 opacity-0"
            >
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <style>
    #form-feedback.show {
      display: block;
      transform: scale(1);
      opacity: 1;
    }
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type="number"] {
      -moz-appearance: textfield;
      appearance: textfield;
    }
  </style>

  <script>
    const showState = (stateId: string) => {
      const states = [
        "loading-state",
        "error-state",
        "success-state",
        "vetting-success-state",
        "vetting-form-container",
      ];
      states.forEach((id) => {
        const el = document.getElementById(id);
        if (el) {
          if (id === stateId) {
            el.classList.remove("hidden");
            el.classList.add("flex");
            if (id === "vetting-form-container") {
              el.classList.remove("flex");
              setTimeout(() => {
                el.classList.remove("opacity-0", "translate-y-4");
                el.classList.add("opacity-100", "translate-y-0");
              }, 50);
            }
          } else {
            el.classList.add("hidden");
            el.classList.remove("flex", "opacity-100", "translate-y-0");
          }
        }
      });
    };

    const handleInitialVerification = async () => {
      const urlParams = new URLSearchParams(window.location.search);
      const token = urlParams.get("token");
      const firstnameSpan = document.getElementById("contact-firstname");

      if (!token) {
        showState("error-state");
        return;
      }

      try {
        const minDelay = new Promise((resolve) => setTimeout(resolve, 1500));
        const responsePromise = fetch("/api/verify-vetting", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ token }),
        });
        const [response] = await Promise.all([responsePromise, minDelay]);

        if (response.ok) {
          const data = await response.json().catch(() => ({}));
          if (firstnameSpan && data.contactName) {
            firstnameSpan.textContent = data.contactName;
          }

          // Check if already submitted locally as a fallback to status check
          const lastSub = localStorage.getItem("last_vetting_submission");
          const recentlySubmitted =
            lastSub && Date.now() - parseInt(lastSub) < 3600000; // 1 hour

          data.completed || recentlySubmitted
            ? showState("success-state")
            : showState("vetting-form-container");
        } else {
          showState("error-state");
        }
      } catch (error) {
        showState("error-state");
      }
    };

    const setupVettingForm = () => {
      // Number Input Counter
      const hoursInput = document.getElementById(
        "hours-lost",
      ) as HTMLInputElement | null;
      const inc = document.getElementById("increment-hours");
      const dec = document.getElementById("decrement-hours");
      if (hoursInput && inc && dec) {
        inc.onclick = () => {
          hoursInput.stepUp();
          hoursInput.dispatchEvent(new Event("change"));
        };
        dec.onclick = () => {
          hoursInput.stepDown();
          hoursInput.dispatchEvent(new Event("change"));
        };
      }

      // Decision Maker Toggle
      const radios = document.querySelectorAll('input[name="isDecisionMaker"]');
      const container = document.getElementById(
        "decision-maker-name-container",
      );
      const input = document.getElementById(
        "decision-maker-name",
      ) as HTMLInputElement | null;
      const phoneInput = document.getElementById(
        "phone",
      ) as HTMLInputElement | null;

      // Smart Phone Formatting
      if (phoneInput) {
        phoneInput.oninput = (e: any) => {
          let x = e.target.value
            .replace(/\D/g, "")
            .match(/(\d{0,3})(\d{0,3})(\d{0,4})/);
          if (x[1] && !x[2] && !x[3]) e.target.value = x[1];
          else if (x[1] && x[2] && !x[3]) e.target.value = `(${x[1]}) ${x[2]}`;
          else if (x[1] && x[2] && x[3])
            e.target.value = `(${x[1]}) ${x[2]}-${x[3]}`;
        };
      }
      if (radios.length && container && input) {
        radios.forEach((r) => {
          (r as HTMLInputElement).onchange = () => {
            if ((r as HTMLInputElement).value === "no") {
              container.classList.remove("hidden");
              setTimeout(
                () => container.classList.add("opacity-100", "translate-y-0"),
                10,
              );
              input.required = true;
            } else {
              container.classList.remove("opacity-100", "translate-y-0");
              setTimeout(() => container.classList.add("hidden"), 300);
              input.required = false;
            }
          };
        });
      }

      const form = document.getElementById(
        "vetting-form",
      ) as HTMLFormElement | null;
      const btn = document.getElementById(
        "submit-btn",
      ) as HTMLButtonElement | null;
      const loader = document.getElementById("submit-loader");
      const text = btn?.querySelector("span");
      const feedback = document.getElementById("form-feedback");

      const clearErrors = () => {
        form?.querySelectorAll('[id$="-error"]').forEach((el) => {
          el.textContent = "";
          el.classList.add("hidden");
        });
      };

      const showError = (id: string, msg: string) => {
        const el = document.getElementById(`${id}-error`);
        if (el) {
          el.textContent = msg;
          el.classList.remove("hidden");
        }
      };

      // Clear error on input
      form?.querySelectorAll("input, select, textarea").forEach((input) => {
        const id = input.id;
        input.addEventListener("input", () => {
          const errorEl = document.getElementById(`${id}-error`);
          if (errorEl) errorEl.classList.add("hidden");
          if (feedback) feedback.classList.remove("show");
        });
        input.addEventListener("change", () => {
          const errorEl = document.getElementById(`${id}-error`);
          if (errorEl) errorEl.classList.add("hidden");
          if (feedback) feedback.classList.remove("show");
        });
      });

      if (form) {
        form.onsubmit = async (e) => {
          e.preventDefault();
          clearErrors();

          // Anti-spam & Cooldown check
          const last = localStorage.getItem("last_vetting_submission");
          if (last && Date.now() - parseInt(last) < 600000) {
            if (feedback) {
              feedback.textContent =
                "Please wait a few minutes before submitting again.";
              feedback.className =
                "bg-red-500/20 text-red-400 show p-4 rounded-2xl text-center font-medium";
            }
            return;
          }

          if (btn) btn.disabled = true;
          if (loader) loader.classList.remove("hidden");
          if (text) text.textContent = "Processing...";
          if (feedback) feedback.classList.remove("show");

          try {
            const formData = new FormData(form);
            const data = Object.fromEntries(formData);

            // Honeypot check
            if (data["bot-field"]) throw new Error("Spam detected");

            // Local Validation
            let hasErrors = false;
            if (!data.companyName) {
              showError("company-name", "Company Name is required");
              hasErrors = true;
            }
            if (!data.companyDomain) {
              showError("company-domain", "Domain is required");
              hasErrors = true;
            } else if (
              !/^[a-zA-Z0-9][a-zA-Z0-9-]{1,61}[a-zA-Z0-9]\.[a-zA-Z]{2,}$/.test(
                data.companyDomain.toString(),
              )
            ) {
              showError(
                "company-domain",
                "Please enter a valid domain (e.g. company.com)",
              );
              hasErrors = true;
            }
            if (!data.phone) {
              showError("phone", "Phone is required");
              hasErrors = true;
            } else if (!/^\+?[\d\s\-()]{10,}$/.test(data.phone.toString())) {
              showError("phone", "Please enter a valid phone number");
              hasErrors = true;
            }
            if (!data.annualRevenue) {
              showError("annual-revenue", "Revenue range is required");
              hasErrors = true;
            }
            if (!data.problem) {
              showError("problem", "Problem description is required");
              hasErrors = true;
            }
            if (!data.hoursLost) {
              showError("hours-lost", "Hours lost is required");
              hasErrors = true;
            }
            if (data.isDecisionMaker === "no" && !data.decisionMakerName) {
              showError(
                "decision-maker-name",
                "Decision maker details required",
              );
              hasErrors = true;
            }

            if (hasErrors) throw new Error("Please fix the mistakes above.");

            const response = await fetch("/api/complete-vetting", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(data),
            });

            if (response.ok) {
              localStorage.setItem(
                "last_vetting_submission",
                Date.now().toString(),
              );
              showState("vetting-success-state");
              form.reset();
            } else {
              const errorData = await response.json();
              throw new Error(errorData.error || "Submission failed");
            }
          } catch (err: any) {
            if (feedback) {
              feedback.textContent =
                err.message || "Something went wrong. Please try again.";
              feedback.className =
                "bg-red-500/20 text-red-400 show p-4 rounded-2xl text-center font-medium mt-4";
            }
          } finally {
            if (btn) btn.disabled = false;
            if (loader) loader.classList.add("hidden");
            if (text) text.textContent = "Complete Vetting";
          }
        };
      }
    };

    handleInitialVerification();
    setupVettingForm();

    document.addEventListener("astro:after-swap", () => {
      handleInitialVerification();
      setupVettingForm();
    });
  </script>
</Layout>
