---
interface Props {
  label: string;
  id: string;
  name: string;
  type?: "text" | "email" | "number" | "password" | "tel" | "url" | "date" | "search"; // Simplified to common types
  placeholder?: string;
  required?: boolean;
  pattern?: string;
  title?: string;
  autocomplete?: string;
  class?: string;
}

const { 
  label, 
  id, 
  name, 
  type = "text", 
  placeholder, 
  required = false, 
  pattern, 
  title, 
  autocomplete,
  class: className 
} = Astro.props;
---

<div class={className}>
  <label for={id} class="block text-sm font-bold text-white mb-3">
    {label}
  </label>
  <input
    type={type}
    id={id}
    name={name}
    required={required}
    pattern={pattern}
    title={title}
    autocomplete={autocomplete}
    class="w-full bg-white/5 border border-white/10 rounded-2xl px-5 py-4 text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 transition-all font-medium placeholder:text-white/30"
    placeholder={placeholder}
  />
  <div id={`${id}-error`} class="hidden mt-2 text-xs font-bold text-red-400 pl-2"></div>
</div>
